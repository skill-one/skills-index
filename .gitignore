__pycache__/
*.py[cod]
*.egg-info/
htmlcov/

# Dot-entries are ignored by default (tool caches, IDE state, local secrets
# like .env); whitelist the few that are meant to be versioned.
.*
!/.gitignore
!/.github/

# Generated dataset (published via GitHub Releases, not committed)
data/
cache/
# Local inspection area for `skills-index pull` (downloaded published snapshots)
pulled/
